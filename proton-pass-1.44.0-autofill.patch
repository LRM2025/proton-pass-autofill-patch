+            startsWith="second@example.test"
+            frameId={0}
+            formId="form"
+            fieldId="field"
+            frameOrigin="example.test"
+            origin="example.test"
+            telemetry={{ modelVersion: '', pageLanguage: '' }}
+        />
+    );
+
+    const search = await screen.findByRole('searchbox', { name: 'Search logins' });
+    expect(search).toHaveValue('second@example.test');
+    expect(screen.getByText('Second account')).toBeVisible();
+    expect(screen.queryByText('First account')).not.toBeInTheDocument();
+
+    fireEvent.change(search, { target: { value: 'beyond-the-vault@example.test' } });
+    expect(screen.getByText('No login found')).toBeVisible();
+
+    fireEvent.change(search, { target: { value: '' } });
+    expect(screen.getByText('First account')).toBeVisible();
+    expect(screen.getByText('Second account')).toBeVisible();
+
+    fireEvent.change(search, { target: { value: 'FIRST@EXAMPLE.TEST' } });
+    expect(screen.queryByText('Second account')).not.toBeInTheDocument();
+    fireEvent.click(screen.getByText('First account'));
+    expect(mockForwardMessage).toHaveBeenCalledWith({
+        type: InlinePortMessageType.AUTOFILL_ACTION,
+        payload: expect.objectContaining({ type: 'login', shareId: 'vault', itemId: 'one', fieldId: 'field' }),
+    });
+    expect(mockClose).toHaveBeenCalledWith({ userAction: true });
+});
