+export const getHttpsOrigin = (url?: string): string | undefined => {
+    try {
+        const parsed = new URL(url ?? '');
+        if (parsed.protocol === 'https:') return parsed.origin;
+    } catch {
+        // Invalid or incomplete URLs are not eligible for automatic password fill.
+    }
+};
+
+export const selectUniqueEmailLogin = <T>(
+    candidates: T[],
+    email: string,
+    identifiers: (candidate: T) => string[]
+): T | undefined => {
+    const normalized = email.trim().toLowerCase();
+    const matches = candidates.filter((candidate) =>
+        identifiers(candidate).some((value) => value.trim().toLowerCase() === normalized)
+    );
+    if (matches.length === 1) return matches[0];
+};
