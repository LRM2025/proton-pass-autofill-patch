+    useIFrameAppState: () => ({ settings: {}, visible: true }),
+    useIFrameAppController: () => ({ close: mockClose, forwardMessage: mockForwardMessage }),
+    useRegisterMessageHandler: jest.fn(),
+}));
+jest.mock('../components/DropdownFocusController', () => ({ useFocusController: () => ({ focusRef: null }) }));
