+jest.mock('@proton/pass/hooks/useTelemetryEvent', () => ({ useTelemetryEvent: () => jest.fn() }));
+jest.mock('../../../../../../../lib/components/Inline/PauseListDropdown', () => ({ PauseListDropdown: () => null }));
