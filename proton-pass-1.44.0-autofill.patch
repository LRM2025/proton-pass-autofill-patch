+import { FieldType, FormType } from '@protontech/autofill/types';
+
+import type { FieldHandle } from '../form/field';
+
+export const getLoginEmailField = (password: FieldHandle) => {
+    const form = password.getFormHandle();
+    if (password.fieldType !== FieldType.PASSWORD_CURRENT || form.formType !== FormType.LOGIN) return;
+
+    const identifiers = [...form.getFieldsFor(FieldType.EMAIL), ...form.getFieldsFor(FieldType.USERNAME)];
+    if (identifiers.length === 1) return identifiers[0];
+};
