+    contentScriptMessage: (message: unknown) => message,
+    sendMessage: {
+        on: async (message: { type: WorkerMessageType }, resolve: (response: unknown) => void) => {
+            if (message.type === WorkerMessageType.AUTOFILL_LOGIN_QUERY) {
